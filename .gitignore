# Proyectos de HyperFrames (_motion/): se versiona la fuente; los renders y las capturas de revisión no.
# Los videos para la web son las versiones comprimidas de img/motion/.
_motion/*/renders/
_motion/*/.hyperframes/
_motion/*/node_modules/

# Capturas y videos de revisión de la web (no se publican)
_revision/

# Astro y herramientas
node_modules/
dist/
.astro/
test-results/
playwright-report/
# Impeccable y Taste: borradores y capturas de revisión (el contrato de diseño sí se versiona)
.impeccable/mocks/
.impeccable/review/
.impeccable/questions/
.impeccable/decision-payload.json
.taste-skill/
.impeccable/tmp/
