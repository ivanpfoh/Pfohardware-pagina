---
import "../styles/global.css";
import Encabezado from "../components/Encabezado.astro";
import Pie from "../components/Pie.astro";
import { SITIO } from "../consts";

interface Props {
  titulo: string;
  descripcion: string;
  ruta?: string;            // "" para la portada, "servicios.html", etc.
  actual?: "inicio" | "servicios" | "quiensoy" | "contacto" | "descarga" | "otra";
  ogTitulo?: string;
  ogDescripcion?: string;
  ogTipo?: string;
  noIndexar?: boolean;
  datosEstructurados?: Record<string, unknown>;
}
const {
  titulo, descripcion, ruta = "", actual = "otra",
  ogTitulo = titulo, ogDescripcion = descripcion, ogTipo = "website", noIndexar = false, datosEstructurados,
} = Astro.props;
const canonica = SITIO + ruta;
const imagenOg = SITIO + "img/og-pfohardware.jpg";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noIndexar ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonica} />}
    <meta name="theme-color" content="#05080A" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="img/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="img/apple-touch-icon.png" />
    {!noIndexar && (
      <>
        <meta property="og:type" content={ogTipo} />
        <meta property="og:locale" content="es_AR" />
        <meta property="og:site_name" content="PfoHardware" />
        <meta property="og:title" content={ogTitulo} />
        <meta property="og:description" content={ogDescripcion} />
        <meta property="og:url" content={canonica} />
        <meta property="og:image" content={imagenOg} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <script is:inline>
      // Las entradas animadas arrancan ocultas solo si hay JS.
      // Si el script principal no llega a cargar, a los 2,5 s se muestra todo igual.
      (function () {
        var r = document.documentElement;
        // Con "reducir movimiento" (también cuando Windows tiene las animaciones apagadas) todo se ve de entrada
        r.classList.add(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches ? "quieto" : "mov");
        setTimeout(function () { if (!r.classList.contains("app")) r.classList.remove("mov", "quieto"); }, 2500);
      })();
    </script>
    {datosEstructurados && <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Encabezado actual={actual} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <slot name="despues" />
    <script>
      import { iniciarBase } from "../scripts/base";
      iniciarBase();
    </script>
  </body>
</html>
