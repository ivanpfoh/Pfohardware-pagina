---
// La compra: el botón degradé del programa, a escala de sección.
import Icono from "./Icono.astro";
import { ARREPENTIMIENTO, COMPRAR, PRECIO, RECUPERAR } from "../consts";

const incluye = [
  "Licencia para 1 computadora con Windows 10 u 11.",
  "Tu clave llega por mail, queda vinculada a tu PC y la recuperás cuando quieras con tu número de operación.",
  "Actualizaciones: si encuentro nuevas formas de optimizar tu PC, actualizo el programa y él mismo te avisa.",
  "Soporte directo y personal: ante cualquier duda o problema, te atiendo yo.",
];
---
<section class="compra" id="comprar" aria-labelledby="compra-titulo">
  <div class="contenedor compra-grilla">
    <div class="compra-izq">
      <h2 id="compra-titulo" data-titulo><span class="linea"><span class="num">{PRECIO}</span></span><span class="linea"><span>una sola vez.</span></span></h2>
      <p class="compra-bajada" data-entra>Pago único con Mercado Pago, sin suscripciones. Al aprobarse el pago ves tu clave y el link de descarga en pantalla, y también te llegan por mail.</p>
      <div class="compra-acciones" data-entra>
        <a class="boton boton-oscuro boton-grande" href={COMPRAR} aria-describedby="compra-legal">Comprar y descargar <Icono nombre="flecha" tam={18} /></a>
        <a class="compra-recuperar" href={RECUPERAR}>¿Ya lo compraste? Recuperá tu clave y la descarga</a>
      </div>
    </div>
    <div class="compra-der">
      <ul class="incluye">
        {incluye.map((i) => <li data-entra><Icono nombre="check" tam={20} grosor={2.6} /><span>{i}</span></li>)}
      </ul>
      <p class="legal" id="compra-legal" data-entra>
        <strong>Compra y licencia:</strong> pago único con Mercado Pago, sin suscripciones. La licencia es para 1 computadora con Windows 10 u 11. Tenés <strong>10 días corridos para arrepentirte</strong> de la compra (Ley 24.240); si pedís la devolución, la licencia se desactiva.
        <a href={ARREPENTIMIENTO} target="_blank" rel="noopener noreferrer">Botón de arrepentimiento</a>
      </p>
    </div>
  </div>
</section>

<style>
  .compra { padding-block: var(--seccion); background: var(--degrade); color: var(--texto-marca); }
  .compra-grilla { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(36px, 6vw, 104px); align-items: end; }
  .compra h2 { font-size: clamp(3.2rem, 9vw, 8.4rem); line-height: 0.9; letter-spacing: -0.055em; }
  .compra-bajada { margin-top: 28px; max-width: 30em; font-size: 1.15rem; font-weight: 600; }
  .compra-acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 32px; }
  .compra-recuperar { font-weight: 600; text-decoration: underline; text-underline-offset: 0.25em; }
  .incluye { list-style: none; display: grid; gap: 16px; }
  .incluye li { display: flex; gap: 14px; font-weight: 600; font-size: 1.05rem; line-height: 1.45; }
  .incluye :global(svg) { flex: none; margin-top: 2px; }
  .legal { margin: 32px 0 0; font-size: 0.92rem; line-height: 1.6; max-width: 40em; }
  .legal a { font-weight: 700; }
  .compra :global(::selection) { background: var(--texto-marca); color: var(--marca-1); }
  .compra :global(:focus-visible) { outline-color: var(--texto-marca); }
  @media (max-width: 900px) {
    .compra-grilla { grid-template-columns: 1fr; }
    .compra-acciones .boton { width: 100%; }
  }
</style>
