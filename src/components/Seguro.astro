---
// "Deshacer cambios" mostrado como capas: la pantalla de "Optimización completada" se corre y debajo
// reaparece el programa como estaba. Las dos son cuadros reales del video del Optimizador.
import Icono from "./Icono.astro";
---
<section class="seguro" id="seguro" aria-labelledby="seguro-titulo">
  <div class="contenedor seguro-grilla">
    <div class="capas" data-capas aria-hidden="true" data-ui>
      <figure class="capa capa-abajo">
        <img src="img/motion/hero-optimizador-programa.webp" alt="" width="900" height="966" loading="lazy" decoding="async" />
      </figure>
      <figure class="capa capa-arriba" data-capa-arriba>
        <img src="img/motion/hero-optimizador-final.webp" alt="" width="900" height="966" loading="lazy" decoding="async" />
      </figure>
      <i class="capa-borde" data-capa-borde></i>
      <p class="capas-rotulo"><span class="rotulo-a">Después de optimizar</span><span class="rotulo-b"><Icono nombre="deshacer" tam={16} grosor={2.4} /> Con Deshacer cambios</span></p>
    </div>
    <div class="seguro-texto">
      <h2 id="seguro-titulo" data-titulo><span class="linea"><span>Si algo no te gusta,</span></span><span class="linea"><span>lo deshacés.</span></span></h2>
      <p class="seguro-grande" data-entra>Antes de optimizar, el programa guarda tu configuración y, si el equipo lo permite, crea un punto de restauración de Windows. Con <strong>Deshacer cambios</strong> volvés todo a como estaba.</p>
      <ul class="nunca" data-entra>
        <li><Icono nombre="escudo" tam={20} /><span>Nunca vacía la Papelera sin preguntarte.</span></li>
        <li><Icono nombre="escudo" tam={20} /><span>Nunca desactiva tu antivirus, el firewall ni las actualizaciones de Windows.</span></li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { escritorio, moverPoco } from "../scripts/base";
  import { cargarMovimiento } from "../scripts/movimiento";

  const capas = document.querySelector<HTMLElement>("[data-capas]");
  if (capas && moverPoco() && "IntersectionObserver" in window) {
    // "Reducir movimiento": la capa de arriba se desvanece en lugar de correrse
    capas.classList.add("con-fundido");
    new IntersectionObserver(([e], o) => {
      if (!e.isIntersecting) return;
      o.disconnect();
      window.setTimeout(() => capas.classList.add("deshecho"), 900);
    }, { threshold: 0.6 }).observe(capas);
  } else if (capas && !moverPoco()) {
    if (escritorio()) {
      // Escritorio: el scroll corre la capa de arriba
      cargarMovimiento().then(({ gsap }) => {
        capas.classList.add("con-scroll");
        gsap.timeline({ scrollTrigger: { trigger: capas, start: "top 65%", end: "bottom 45%", scrub: 0.8 } })
          .fromTo("[data-capa-arriba]", { clipPath: "inset(0% 0% 0% 0% round 14px)" }, { clipPath: "inset(0% 100% 0% 0% round 14px)", ease: "power2.inOut", duration: 1 })
          .fromTo("[data-capa-borde]", { left: "100%", opacity: 1 }, { left: "0%", ease: "power2.inOut", duration: 1 }, 0)
          .to("[data-capa-borde]", { opacity: 0, duration: 0.04 }, 0.96)
          .call(() => capas.classList.toggle("deshecho"), [], 0.55);
      });
    } else if ("IntersectionObserver" in window) {
      // Celular: se deshace solo, una vez, al verse
      capas.classList.add("con-tiempo");
      new IntersectionObserver(([e], o) => {
        if (!e.isIntersecting) return;
        o.disconnect();
        window.setTimeout(() => capas.classList.add("deshecho"), 900);
      }, { threshold: 0.6 }).observe(capas);
    }
  }
</script>

<style>
  .seguro { padding-block: var(--seccion); background: var(--campo-1); }
  .seguro-grilla { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(36px, 7vw, 120px); align-items: center; }
  .capas { position: relative; aspect-ratio: 900 / 966; max-width: 560px; margin-top: 52px; }
  .capa { position: absolute; inset: 0; margin: 0; border-radius: var(--radio-ventana); overflow: hidden; border: 1px solid var(--borde); background: var(--fondo); } /* taste-skill-ignore: marco de la captura del programa */
  .capa img { width: 100%; height: 100%; object-fit: cover; }
  .capas.con-fundido .capa-arriba { transition: none; }
  .capas.con-fundido.deshecho .capa-arriba { opacity: 0; }
  .capas.con-tiempo .capa-arriba { transition: clip-path 1200ms var(--ease-in-out); clip-path: inset(0% 0% 0% 0% round 14px); }
  .capas.con-tiempo.deshecho .capa-arriba { clip-path: inset(0% 100% 0% 0% round 14px); }
  /* La línea del barrido de Deshacer cambios */
  .capa-borde { position: absolute; top: -8px; bottom: -8px; left: 100%; width: 3px; margin-left: -1.5px; border-radius: 3px; background: var(--degrade); opacity: 0; pointer-events: none; }
  .capas.con-tiempo .capa-borde { opacity: 1; transition: left 1200ms var(--ease-in-out), opacity 300ms ease 1100ms; }
  .capas.con-tiempo.deshecho .capa-borde { left: 0%; opacity: 0; }
  .capas-rotulo { position: absolute; left: 0; bottom: calc(100% + 12px); margin: 0; font-weight: 600; font-size: 0.9rem; }
  .capas-rotulo span { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; background: var(--panel); transition: opacity 300ms ease; }
  .rotulo-b { position: absolute; left: 0; bottom: 0; white-space: nowrap; opacity: 0; color: var(--marca-1); }
  .capas.deshecho .rotulo-a { opacity: 0; }
  .capas.deshecho .rotulo-b { opacity: 1; }
  .seguro-grande { margin-top: 28px; font: 600 clamp(1.15rem, 1.6vw, 1.4rem)/1.45 var(--letra-titulo); max-width: 30em; }
  .seguro-grande strong { color: var(--marca-1); }
  .nunca { list-style: none; display: grid; gap: 12px; margin-top: 28px; }
  .nunca li { display: flex; gap: 12px; }
  .nunca :global(svg) { flex: none; margin-top: 2px; color: var(--marca-1); }
  @media (max-width: 900px) {
    .seguro-grilla { grid-template-columns: 1fr; }
    .capas { max-width: 440px; order: 2; }
  }
</style>
