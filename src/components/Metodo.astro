---
// El método de trabajo: cuatro pasos en orden, unidos por una barra que se llena como la del programa.
const pasos = [
  { titulo: "Revisión", texto: "Escucho qué pasa y reviso el equipo con pruebas concretas." },
  { titulo: "Propuesta", texto: "Te explico el problema, las alternativas y el costo total." },
  { titulo: "Resolución", texto: "Hago el trabajo acordado y verifico estabilidad y rendimiento." },
  { titulo: "Entrega", texto: "Recibís el equipo probado, limpio y con recomendaciones de uso." },
];
---
<section class="metodo-seccion" id="proceso" aria-labelledby="metodo-titulo">
  <div class="contenedor">
    <h2 id="metodo-titulo" data-titulo><span class="linea"><span>De la falla</span></span><span class="linea"><span>a la solución.</span></span></h2>
    <ol class="metodo" data-metodo>
      {pasos.map((p) => (
        <li class="paso">
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // La barra se llena cuando el método se ve; cada paso se enciende cuando la barra le llega
  import { moverPoco } from "../scripts/base";
  document.querySelectorAll<HTMLElement>("[data-metodo]").forEach((m) => {
    if (moverPoco() || !("IntersectionObserver" in window)) { m.classList.add("lleno"); return; }
    m.classList.add("animable");
    new IntersectionObserver(([e], o) => {
      if (!e.isIntersecting) return;
      m.classList.add("lleno");
      o.disconnect();
    }, { threshold: 0.45 }).observe(m);
  });
</script>

<style>
  .metodo-seccion { padding-block: var(--seccion); background: var(--campo-1); }
  .metodo { list-style: none; position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; margin-top: clamp(48px, 6vw, 88px); padding-top: 44px; }
  /* La pista del anillo del programa, estirada: gris de fondo y el degradé que avanza */
  .metodo::before, .metodo::after { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 6px; border-radius: 6px; }
  .metodo::before { background: var(--linea); }
  .metodo::after { background: var(--degrade); transform-origin: left; transform: scaleX(1); }
  .metodo.animable::after { transform: scaleX(0); }
  .metodo.animable.lleno::after { transform: scaleX(1); transition: transform 2200ms var(--ease-in-out) 200ms; }
  .paso h3 { font-size: clamp(1.5rem, 2.3vw, 2rem); margin-bottom: 12px; }
  .paso p { margin: 0; max-width: 22em; }
  .metodo.animable .paso { opacity: 0.35; transition: opacity 600ms ease; }
  .metodo.animable.lleno .paso { opacity: 1; }
  .metodo.animable.lleno .paso:nth-child(1) { transition-delay: 300ms; }
  .metodo.animable.lleno .paso:nth-child(2) { transition-delay: 850ms; }
  .metodo.animable.lleno .paso:nth-child(3) { transition-delay: 1400ms; }
  .metodo.animable.lleno .paso:nth-child(4) { transition-delay: 1950ms; }
  @media (max-width: 900px) {
    .metodo { grid-template-columns: 1fr; gap: 36px; padding: 0 0 0 36px; }
    .metodo::before, .metodo::after { top: 0; bottom: 0; left: 0; right: auto; width: 6px; height: auto; }
    .metodo::after { transform-origin: top; }
    .metodo.animable::after { transform: scaleY(0); }
    .metodo.animable.lleno::after { transform: scaleY(1); }
  }
</style>
