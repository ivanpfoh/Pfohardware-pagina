---
// La portada: el Optimizador abierto a escala de página. La cabecera del programa lleva el título y el
// precio; el campo del anillo arranca con el video de HyperFrames (_motion/campo-portada: el logo PH
// grande que se vuelve el anillo) y al terminar queda el anillo que se toca. Los botones, el selector
// de modos y las pantallas copian al programa real. Es una demostración: no toca la PC de nadie.
import Ventana from "./Ventana.astro";
import Icono from "./Icono.astro";
import { COMPRAR, PRECIO } from "../consts";
---
<section class="portada" id="optimizador" aria-labelledby="portada-titulo">
  <div class="contenedor">
    <Ventana class="portada-ventana" pagina>
      <div class="pp" data-pp data-estado="reposo" data-modo="completa">
        <div class="pp-cabeza">
          <img class="pp-logo" src="img/logo-ph-96.png" alt="" width="56" height="56" />
          <div class="pp-nombre">
            <h1 id="portada-titulo" data-titulo><span class="linea"><span>Tu PC, más fluida</span></span><span class="linea"><span>con un clic.</span></span></h1>
            <p data-entra>Optimizador PfoHardware para Windows 10 y 11</p>
          </div>
          <p class="pp-precio" data-entra><strong class="num">{PRECIO}</strong><span>pago único</span></p>
        </div>

        <div class="pp-campo" aria-hidden="true" data-ui>
          <svg class="pp-anillo" viewBox="0 0 120 120">
            <defs>
              <linearGradient id="pp-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#00F5A0" /><stop offset="1" stop-color="#1FDDF5" />
              </linearGradient>
            </defs>
            <circle class="pp-pista" cx="60" cy="60" r="52" />
            <circle class="pp-avance" cx="60" cy="60" r="52" stroke="url(#pp-grad)" pathLength="100" transform="rotate(-90 60 60)" />
            <path class="pp-rayo" d="M63 38 47 63h12l-3 19 16-26H60z" />
            <path class="pp-check" d="M42 61l12 12 24-26" pathLength="1" />
          </svg>
          <p class="pp-pct num"><span data-pct>0</span><small>%</small></p>
          <video class="pp-intro" data-intro muted playsinline preload="none" disablepictureinpicture
            poster="img/motion/campo-portada-inicio.webp" width="1920" height="640">
            <source src="img/motion/campo-portada.mp4" type="video/mp4" />
          </video>
        </div>

        <div class="pp-textos" aria-live="polite">
          <p class="pp-titulo" data-titulo-app>Tu PC está lista para optimizar</p>
          <p class="pp-sub" data-sub-app>Deja toda la PC más liviana: arranca más rápido, con menos programas y permisos en segundo plano, y rinde más en juegos.</p>
        </div>

        <div class="pp-controles pp-solo-reposo" data-ui>
          <div class="pp-segmentos" role="radiogroup" aria-label="Modo de optimización">
            <button type="button" role="radio" aria-checked="true" data-modo-btn="completa">Optimización completa</button>
            <button type="button" role="radio" aria-checked="false" data-modo-btn="juegos" tabindex="-1">Solo juegos</button>
          </div>
          <button type="button" class="pp-optimizar" data-optimizar>Optimizar ahora</button>
        </div>
        <div class="pp-controles pp-solo-trabajando" data-ui>
          <button type="button" class="pp-boton pp-boton-chico" data-cancelar>Cancelar</button>
        </div>
        <div class="pp-controles pp-solo-listo" data-ui>
          <div class="pp-fila">
            <button type="button" class="pp-boton" data-deshacer><Icono nombre="deshacer" tam={17} grosor={2.4} /> Deshacer cambios</button>
            <button type="button" class="pp-boton pp-boton-listo" data-listo>Listo</button>
          </div>
        </div>

        <div class="pp-pie" data-ui>
          <p class="pp-nota" data-nota><i class="punto" aria-hidden="true"></i><span data-nota-texto>Demostración: se ve y responde como el programa, pero no toca tu PC.</span></p>
          <a class="boton pp-comprar" href={COMPRAR} data-comprar>Comprar y descargar <span class="num">· {PRECIO}</span> <Icono nombre="flecha" tam={18} /></a>
        </div>
      </div>
    </Ventana>
  </div>
</section>

<script>
  import { ahorroDatos, moverPoco } from "../scripts/base";

  const MODOS: Record<string, string> = {
    completa: "Deja toda la PC más liviana: arranca más rápido, con menos programas y permisos en segundo plano, y rinde más en juegos.",
    juegos: "Para jugar: además ajusta tu placa de video NVIDIA o Intel a máximo rendimiento, sin tocar tus programas de inicio ni tu privacidad.",
  };
  const TITULOS = { reposo: "Tu PC está lista para optimizar", trabajando: "Optimizando tu PC", deshaciendo: "Optimizando tu PC", listo: "Optimización completada" };
  const NOTA = "Demostración: se ve y responde como el programa, pero no toca tu PC.";

  const pp = document.querySelector<HTMLElement>("[data-pp]");
  if (pp) {
    const pct = pp.querySelector<HTMLElement>("[data-pct]")!;
    const avance = pp.querySelector<SVGCircleElement>(".pp-avance")!;
    const titulo = pp.querySelector<HTMLElement>("[data-titulo-app]")!;
    const sub = pp.querySelector<HTMLElement>("[data-sub-app]")!;
    const nota = pp.querySelector<HTMLElement>("[data-nota-texto]")!;
    const intro = pp.querySelector<HTMLVideoElement>("[data-intro]")!;
    let corrida = 0;
    let cuadro = 0;

    // --- La entrada: el video del logo que se vuelve el anillo; al terminar queda el anillo de verdad
    const terminarIntro = (): void => {
      if (pp.classList.contains("en-vivo")) return;
      pp.classList.add("en-vivo");
      intro.pause();
    };
    if (moverPoco() || ahorroDatos()) terminarIntro();
    else {
      intro.addEventListener("ended", terminarIntro);
      intro.addEventListener("error", terminarIntro, true);
      intro.preload = "auto";
      // Una pausa para que el logo se vea grande antes de que se transforme
      window.setTimeout(() => { intro.play().catch(terminarIntro); }, 900);
      // Si el video no llega a arrancar, no se queda tapando el anillo
      window.setTimeout(() => { if (intro.paused && intro.currentTime === 0) terminarIntro(); }, 6000);
    }

    const fijarAvance = (valor: number): void => {
      avance.style.strokeDashoffset = String(100 - valor);
      pct.textContent = String(Math.round(valor));
    };
    const ir = (estado: keyof typeof TITULOS): void => {
      pp.dataset.estado = estado;
      titulo.textContent = TITULOS[estado];
      if (estado === "reposo") sub.textContent = MODOS[pp.dataset.modo ?? "completa"];
      else if (estado === "listo") sub.textContent = pp.dataset.modo === "completa" ? "9 de 9 ajustes aplicados" : "";
      else sub.textContent = "Esto toma solo unos segundos";
      nota.textContent = estado === "listo" ? "Eso fue todo: un clic. En tu PC lo hace de verdad, y se puede deshacer." : NOTA;
    };

    // Nueve pasos, como el programa: el número sube de a saltos suaves (el programa real tarda más)
    const optimizar = (): void => {
      terminarIntro();
      const esta = ++corrida;
      ir("trabajando");
      fijarAvance(0);
      const duracion = 3400;
      const inicio = performance.now();
      const paso = (ahora: number): void => {
        if (esta !== corrida) return;
        const t = Math.min(1, (ahora - inicio) / duracion);
        const tramo = Math.min(8, Math.floor(t * 9));
        const dentro = Math.min(1, (t * 9 - tramo) * 1.6);
        fijarAvance(((tramo + (1 - Math.pow(1 - dentro, 3))) / 9) * 100);
        if (t < 1) cuadro = requestAnimationFrame(paso);
        else {
          fijarAvance(100);
          ir("listo");
          pp.querySelector<HTMLButtonElement>("[data-deshacer]")?.focus({ preventScroll: true });
        }
      };
      cuadro = requestAnimationFrame(paso);
    };

    // Deshacer: el anillo se vacía y todo vuelve a como estaba
    const volver = (vaciar: boolean): void => {
      const esta = ++corrida;
      cancelAnimationFrame(cuadro);
      const fin = (): void => { fijarAvance(0); ir("reposo"); pp.querySelector<HTMLButtonElement>("[data-optimizar]")?.focus({ preventScroll: true }); };
      if (!vaciar) { fin(); return; }
      ir("deshaciendo");
      titulo.textContent = "Deshaciendo cambios";
      const desde = Number(pct.textContent) || 100;
      const inicio = performance.now();
      const paso = (ahora: number): void => {
        if (esta !== corrida) return;
        const t = Math.min(1, (ahora - inicio) / 800);
        fijarAvance(desde * Math.pow(1 - t, 3));
        if (t < 1) cuadro = requestAnimationFrame(paso);
        else fin();
      };
      cuadro = requestAnimationFrame(paso);
    };

    pp.querySelector("[data-optimizar]")?.addEventListener("click", optimizar);
    pp.querySelector("[data-cancelar]")?.addEventListener("click", () => volver(false));
    pp.querySelector("[data-deshacer]")?.addEventListener("click", () => volver(true));
    pp.querySelector("[data-listo]")?.addEventListener("click", () => volver(false));

    // Selector de modos (un grupo de opciones: las flechas cambian la elección)
    const botones = [...pp.querySelectorAll<HTMLButtonElement>("[data-modo-btn]")];
    const elegir = (b: HTMLButtonElement): void => {
      pp.dataset.modo = b.dataset.modoBtn!;
      botones.forEach((o) => { o.setAttribute("aria-checked", String(o === b)); o.tabIndex = o === b ? 0 : -1; });
      if (pp.dataset.estado === "reposo") sub.textContent = MODOS[pp.dataset.modo];
    };
    botones.forEach((b) => b.addEventListener("click", () => elegir(b)));
    pp.querySelector(".pp-segmentos")?.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== "ArrowLeft" && k !== "ArrowRight") return;
      e.preventDefault();
      const otro = botones.find((b) => b.getAttribute("aria-checked") === "false")!;
      elegir(otro);
      otro.focus();
    });
  }
</script>

<style>
  /* El fondo de la portada es el tono de panel de la paleta; la ventana tiene el negro del programa */
  .portada { padding: var(--header) 0 clamp(48px, 7vw, 96px); background: var(--campo-2); }
  .portada-ventana { max-width: 1240px; margin-inline: auto; }

  /* Medidas en proporción al ancho de la ventana (cqw) y del campo (cqh), como el programa */
  .pp {
    container-type: inline-size;
    display: grid; grid-template-rows: auto auto auto auto auto;
    padding: clamp(16px, 1.7vw, 24px) clamp(18px, 3vw, 44px) clamp(12px, 1.1vw, 16px);
  }
  .pp-cabeza { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(14px, 1.6vw, 22px); align-items: start; }
  .pp-logo { width: clamp(40px, 4.2vw, 56px); height: auto; margin-top: 0.35em; }
  .pp-nombre h1 { font-size: clamp(2.1rem, 3.7vw, 3.5rem); line-height: 0.98; letter-spacing: -0.04em; }
  .pp-nombre p { margin: 8px 0 0; color: var(--texto-dim); font-size: clamp(0.95rem, 1.2vw, 1.12rem); }
  .pp-precio { margin: 0; display: grid; justify-items: end; text-align: right; line-height: 1.05; }
  .pp-precio strong { font: 600 clamp(1.7rem, 3.1vw, 3rem)/1 var(--letra-titulo); letter-spacing: -0.035em; }
  .pp-precio span { margin-top: 6px; color: var(--texto-dim); font-size: clamp(0.9rem, 1.1vw, 1.05rem); }

  .pp-campo {
    /* En escritorio el campo toma el alto que sobra para que la ventana entre entera en la pantalla */
    position: relative; container-type: size; height: clamp(180px, calc(100svh - 596px), 400px);
    margin: clamp(8px, 0.9vw, 12px) calc(clamp(18px, 3vw, 44px) * -1) 0;
    background-image: radial-gradient(rgba(36, 50, 56, 0.85) 0.3cqh, transparent 0.345cqh), radial-gradient(closest-side, rgba(18, 232, 214, 0.07), transparent); /* taste-skill-ignore: campo de puntos del programa (pieza data-ui) */
    background-size: 4cqh 4cqh, 60% 100%;
    background-position: center, center; background-repeat: repeat, no-repeat;
    overflow: hidden;
  }
  .pp-anillo { position: absolute; left: 50%; top: 50%; width: 70cqh; height: 70cqh; translate: -50% -50%; overflow: visible; }
  .pp-anillo circle { fill: none; stroke-width: 7; }
  .pp-pista { stroke: var(--linea); }
  .pp-avance { stroke-dasharray: 100 102; stroke-dashoffset: 100; stroke-linecap: round; opacity: 0; }
  .pp-rayo { fill: var(--marca); transform-origin: 60px 60px; transition: opacity 250ms ease, scale 400ms var(--ease-out); }
  .pp-check { fill: none; stroke: var(--marca-1); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .pp-pct { position: absolute; left: 50%; top: 50%; translate: -50% -50%; margin: 0; font: 600 13cqh/1 var(--letra-titulo); letter-spacing: -0.02em; opacity: 0; transition: opacity 200ms ease; }
  .pp-pct small { font-size: 0.48em; color: var(--texto-dim); margin-left: 0.12em; }
  /* El video está hecho a 3:1 con el anillo al 70 % de su alto, igual que el anillo de la página:
     en un campo más ancho se ve entero (contain) y en uno más angosto se recorta a los costados (cover).
     Así el anillo del video cae siempre justo encima del anillo que se toca. */
  .pp-intro { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 300ms ease; }
  @container (aspect-ratio < 3) { .pp-intro { object-fit: cover; } }
  .pp.en-vivo .pp-intro { opacity: 0; pointer-events: none; }

  .pp-textos { text-align: center; margin-top: clamp(10px, 1vw, 14px); }
  .pp-titulo { margin: 0; font: 600 clamp(1.25rem, 2vw, 1.8rem)/1.2 var(--letra-titulo); letter-spacing: -0.015em; }
  .pp-sub { margin: 6px auto 0; max-width: 72em; min-height: 1.6em; color: var(--texto-dim); font-size: clamp(0.95rem, 1.1vw, 1.05rem); text-wrap: balance; }

  /* Las tres filas de controles ocupan siempre el mismo alto: la ventana no cambia de tamaño entre estados */
  .pp-controles { display: none; gap: 10px; margin-top: clamp(12px, 1.4vw, 18px); min-height: 130px; align-content: start; }
  .pp[data-estado="reposo"] .pp-solo-reposo,
  .pp[data-estado="trabajando"] .pp-solo-trabajando,
  .pp[data-estado="listo"] .pp-solo-listo { display: grid; }
  .pp-solo-reposo { grid-template-columns: 1fr; }
  .pp-solo-trabajando { justify-items: center; }

  .pp-segmentos { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 5px; border-radius: var(--radio-ventana); background: var(--panel); border: 1px solid var(--borde); } /* taste-skill-ignore: selector de modos del programa (pieza data-ui) */
  .pp-segmentos button {
    min-height: 48px; border: 1px solid transparent; border-radius: 10px; background: transparent; cursor: pointer; /* taste-skill-ignore: selector de modos del programa (pieza data-ui) */
    font: 600 clamp(0.92rem, 1.1vw, 1.05rem)/1.2 var(--letra); color: var(--texto-dim); transition: background-color 200ms ease, color 200ms ease;
  }
  .pp-segmentos button[aria-checked="true"] { background: #0C2A23; border-color: #145442; color: var(--marca-1); }
  @media (hover: hover) and (pointer: fine) { .pp-segmentos button[aria-checked="false"]:hover { color: var(--texto); } }
  .pp-optimizar {
    min-height: 60px; border: 0; border-radius: var(--radio-ventana); background: var(--degrade); color: var(--texto-marca); cursor: pointer;
    font: 700 clamp(1.05rem, 1.4vw, 1.25rem)/1 var(--letra); transition: transform 160ms var(--ease-out), box-shadow 300ms ease;
  }
  .pp-optimizar:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .pp-optimizar:hover { box-shadow: 0 0 0 4px rgba(18, 232, 214, 0.2); } } /* taste-skill-ignore: respuesta al pasar el mouse, no queda en reposo */
  /* Recién termina la entrada, el botón invita una vez */
  .pp.en-vivo .pp-optimizar { animation: invita 1.6s var(--ease-out) 0.3s 1; }
  @keyframes invita { 0% { box-shadow: 0 0 0 0 rgba(18, 232, 214, 0.55); } 100% { box-shadow: 0 0 0 18px rgba(18, 232, 214, 0); } } /* taste-skill-ignore: pulso de invitación que se dispara una vez */

  .pp-fila { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 720px; width: 100%; margin-inline: auto; }
  .pp-boton {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 0 18px;
    border: 1px solid var(--borde); border-radius: var(--radio-ventana); background: var(--fondo); color: var(--texto); cursor: pointer; /* taste-skill-ignore: botón secundario del programa (pieza data-ui) */
    font: 600 1rem/1.2 var(--letra); transition: background-color 200ms ease, border-color 200ms ease, transform 160ms var(--ease-out);
  }
  .pp-boton:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .pp-boton:hover { background: var(--panel); border-color: var(--linea); } }
  .pp-boton-chico { min-width: 200px; }
  .pp-boton-listo { background: #172629; border-color: #172629; }

  .pp-pie { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: clamp(10px, 1vw, 14px); }
  .pp-nota { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--pie); font-size: var(--t-chico); }
  .pp-comprar { min-height: 50px; padding: 12px 20px; background: var(--panel); border-color: var(--borde); color: var(--marca-1); }
  @media (hover: hover) and (pointer: fine) { .pp-comprar:hover { border-color: var(--marca); } }
  /* Con la optimización completada, Comprar se vuelve el botón del programa */
  .pp[data-estado="listo"] .pp-comprar { background: var(--degrade); color: var(--texto-marca); border-color: transparent; animation: invita 1.6s var(--ease-out) 0.2s 1; }

  /* Estados del anillo */
  .pp:not([data-estado="reposo"]) .pp-avance { opacity: 1; }
  .pp:not([data-estado="reposo"]) .pp-rayo { opacity: 0; scale: 0.6; }
  .pp[data-estado="trabajando"] .pp-pct, .pp[data-estado="deshaciendo"] .pp-pct { opacity: 1; }
  .pp[data-estado="listo"] .pp-pista, .pp[data-estado="listo"] .pp-avance { stroke: var(--marca-1); }
  .pp[data-estado="listo"] .pp-check { stroke-dashoffset: 0; transition: stroke-dashoffset 500ms var(--ease-out) 80ms; }

  @media (max-width: 760px) {
    .pp-cabeza { grid-template-columns: auto minmax(0, 1fr); }
    .pp-precio { grid-column: 1 / -1; justify-items: start; text-align: left; grid-auto-flow: column; justify-content: start; align-items: baseline; gap: 10px; }
    .pp-campo { height: auto; aspect-ratio: 1.6 / 1; }
    .pp-boton { font-size: 0.95rem; padding: 0 12px; white-space: nowrap; }
    .pp-segmentos button { font-size: 0.84rem; padding: 0 4px; white-space: nowrap; letter-spacing: -0.01em; }
    .pp-pie { flex-direction: column; align-items: stretch; }
    .pp-comprar { width: 100%; }
  }
</style>
