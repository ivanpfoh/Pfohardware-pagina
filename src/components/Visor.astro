---
// Visor de fotos: un <dialog> nativo. Los enlaces con data-galeria se abren acá; sin JS abren la foto grande.
---
<dialog class="visor" aria-label="Vista ampliada de la foto" data-visor>
  <figure>
    <img alt="" data-visor-img />
    <figcaption data-visor-texto></figcaption>
  </figure>
  <div class="visor-controles">
    <button type="button" class="boton boton-panel" data-visor-ant>Anterior</button>
    <button type="button" class="boton boton-panel" data-visor-sig>Siguiente</button>
    <button type="button" class="boton boton-panel visor-cerrar" data-visor-cerrar>Cerrar</button>
  </div>
</dialog>

<script>
  import { pararScroll, seguirScroll } from "../scripts/base";

  const visor = document.querySelector<HTMLDialogElement>("[data-visor]");
  const fotos = [...document.querySelectorAll<HTMLAnchorElement>("a[data-galeria]")];
  if (visor && fotos.length && typeof visor.showModal === "function") {
    const img = visor.querySelector<HTMLImageElement>("[data-visor-img]")!;
    const texto = visor.querySelector<HTMLElement>("[data-visor-texto]")!;
    let actual = 0;
    const mostrar = (i: number): void => {
      actual = (i + fotos.length) % fotos.length;
      const a = fotos[actual];
      const alt = a.querySelector("img")?.alt ?? "";
      img.src = a.href;
      img.alt = alt;
      texto.textContent = alt;
    };
    fotos.forEach((a, i) => a.addEventListener("click", (e) => {
      e.preventDefault();
      mostrar(i);
      visor.showModal();
      pararScroll();
    }));
    visor.addEventListener("close", () => seguirScroll());
    visor.querySelector("[data-visor-ant]")?.addEventListener("click", () => mostrar(actual - 1));
    visor.querySelector("[data-visor-sig]")?.addEventListener("click", () => mostrar(actual + 1));
    visor.querySelector("[data-visor-cerrar]")?.addEventListener("click", () => visor.close());
    visor.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); mostrar(actual - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); mostrar(actual + 1); }
    });
    // Un toque fuera de la foto cierra
    visor.addEventListener("click", (e) => { if (e.target === visor) visor.close(); });
  }
</script>

<style>
  .visor { width: min(1100px, 94vw); max-height: 94vh; padding: 0; border: 0; background: transparent; color: var(--texto); overflow: visible; }
  .visor::backdrop { background: rgba(3, 5, 6, 0.92); }
  .visor[open] { animation: visor-entra 380ms var(--ease-out); }
  .visor[open]::backdrop { animation: visor-fondo 380ms ease; }
  @keyframes visor-entra { from { opacity: 0; transform: translateY(12px) scale(0.97); } }
  @keyframes visor-fondo { from { opacity: 0; } }
  .visor figure { margin: 0; }
  .visor img { max-height: 76vh; width: auto; margin: 0 auto; border-radius: var(--radio); }
  .visor figcaption { margin-top: 14px; text-align: center; color: var(--texto-dim); }
  .visor-controles { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .visor-controles .boton { min-height: 46px; padding: 10px 18px; font-size: 0.95rem; }
</style>
