---
// Cómo se usa, con la grabación real del programa (HyperFrames, _motion/demo-optimizador).
// Los tres pasos se encienden de a uno a medida que se baja: cada paso suma una sola cosa nueva.
---
<section class="como" id="como-funciona" aria-labelledby="como-titulo">
  <div class="contenedor como-grilla">
    <figure class="como-video" data-entra data-ui>
      <video data-demo-real muted loop playsinline preload="none" disablepictureinpicture
        poster="img/motion/hero-optimizador-optimizando.webp" width="900" height="966"
        aria-label="Grabación del Optimizador PfoHardware: un clic en Optimizar ahora, el anillo de progreso llega al 100 % y aparece Optimización completada, con la opción Deshacer cambios.">
        <source src="img/motion/demo-optimizador.mp4" type="video/mp4" />
      </video>
      <figcaption>
        <span>La grabación del programa real, en una PC con Windows 11.</span>
        <button type="button" class="boton boton-panel como-play" data-play hidden>Ver la grabación</button>
      </figcaption>
    </figure>
    <div class="como-texto">
      <h2 id="como-titulo" data-titulo><span class="linea"><span>Así funciona</span></span><span class="linea"><span>en tu PC.</span></span></h2>
      <ol class="pasos" data-pasos>
        <li class="paso" data-paso>
          <h3>Descargá y abrí</h3>
          <p>Al aprobarse el pago ves tu clave y el botón de descarga, y también te llegan por mail. Descomprimí el <code>.zip</code> y abrí el <code>.exe</code>.</p>
        </li>
        <li class="paso" data-paso>
          <h3>Aceptá el permiso</h3>
          <p>El programa te pide permiso de administrador: aceptalo.</p>
        </li>
        <li class="paso" data-paso>
          <h3>Ingresá tu clave y tocá Optimizar ahora</h3>
          <p>Elegís <strong>Optimización completa</strong> o <strong>Solo juegos</strong>, y listo. Si querés volver atrás, usá <strong>Deshacer cambios</strong>.</p>
        </li>
      </ol>
      <ul class="requisitos" aria-label="Requisitos del sistema" data-entra>
        <li><strong>Windows 10 u 11</strong> de 64 bits</li>
        <li><strong>Intel o AMD</strong>, cualquier procesador</li>
        <li><strong>2 GB de RAM</strong> o más</li>
        <li>Permiso de <strong>administrador</strong></li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { ahorroDatos, moverPoco } from "../scripts/base";

  // La grabación corre sola mientras se ve. Con "reducir movimiento" o ahorro de datos no arranca sola:
  // aparece un botón propio, fuera de la ventana, para verla cuando uno quiera
  const video = document.querySelector<HTMLVideoElement>("[data-demo-real]");
  const play = document.querySelector<HTMLButtonElement>("[data-play]");
  if (video && play) {
    const mostrarBoton = (): void => {
      play.hidden = false;
      play.addEventListener("click", () => {
        if (video.paused) { video.preload = "auto"; video.play().catch(() => {}); play.textContent = "Pausar la grabación"; }
        else { video.pause(); play.textContent = "Ver la grabación"; }
      });
    };
    if (moverPoco() || ahorroDatos() || !("IntersectionObserver" in window)) mostrarBoton();
    else new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { video.preload = "auto"; video.play().catch(() => { if (play.hidden) mostrarBoton(); }); }
      else video.pause();
    }, { threshold: 0.35 }).observe(video);
  }

  // El paso que está a la altura de la mitad de la pantalla queda encendido; los demás, atenuados
  const pasos = [...document.querySelectorAll<HTMLElement>("[data-paso]")];
  if (pasos.length && !moverPoco() && "IntersectionObserver" in window) {
    document.querySelector("[data-pasos]")?.classList.add("guiado");
    const marcar = (activo: HTMLElement): void => pasos.forEach((p) => p.classList.toggle("activo", p === activo));
    marcar(pasos[0]);
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => { if (e.isIntersecting) marcar(e.target as HTMLElement); });
    }, { rootMargin: "-45% 0px -45% 0px" });
    pasos.forEach((p) => obs.observe(p));
  }
</script>

<style>
  .como { padding-block: var(--seccion); background: var(--campo-2); scroll-margin-top: var(--header); }
  .como-grilla { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(36px, 7vw, 120px); align-items: start; }
  .como-video { margin: 0; position: sticky; top: calc(var(--header) + 28px); }
  .como-video video { width: 100%; aspect-ratio: 900 / 966; border-radius: var(--radio-ventana); background: var(--panel); box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.9); } /* taste-skill-ignore: grabación de la ventana del programa: Windows le pone sombra a sus ventanas */
  .como-video figcaption { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 14px; color: var(--texto-dim); font-size: var(--t-chico); }
  .como-play { min-height: 44px; padding: 10px 16px; font-size: 0.92rem; }
  .pasos { list-style: none; display: grid; gap: clamp(40px, 7vh, 88px); margin-top: clamp(40px, 5vw, 72px); counter-reset: paso; }
  .paso { position: relative; padding-left: 64px; transition: opacity 400ms ease; }
  .paso::before {
    counter-increment: paso; content: counter(paso);
    position: absolute; left: 0; top: -2px; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--panel); color: var(--texto-dim); font: 600 1.05rem/1 var(--letra-titulo); transition: background 400ms ease, color 400ms ease;
  }
  .paso h3 { margin-bottom: 10px; }
  .paso p { margin: 0; max-width: 32em; }
  .paso code { padding: 2px 6px; border-radius: 6px; background: var(--panel); }
  .pasos.guiado .paso { opacity: 0.4; }
  .pasos.guiado .paso.activo { opacity: 1; }
  .pasos.guiado .paso.activo::before, .pasos:not(.guiado) .paso::before { background: var(--degrade); color: var(--texto-marca); }
  .requisitos { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 24px; margin-top: clamp(48px, 6vw, 80px); padding: 24px; border-radius: var(--radio-ventana); background: var(--panel); }
  .requisitos li { color: var(--texto-dim); }
  .requisitos strong { color: var(--texto); }
  @media (max-width: 900px) {
    .como-grilla { grid-template-columns: 1fr; }
    .como-video { position: static; max-width: 520px; order: 2; }
    .requisitos { grid-template-columns: 1fr; }
  }
</style>
