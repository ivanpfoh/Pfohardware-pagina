---
// La ventana del Optimizador: la barra de título de Windows y el cuerpo oscuro del programa.
// Es una pieza real de la interfaz (data-ui): lleva sus bordes y su barra, como el programa.
interface Props { titulo?: string; class?: string; pagina?: boolean; [k: string]: unknown }
// pagina: la ventana es el marco de una sección entera (la portada), no un recorte de la interfaz
const { titulo = "Optimizador PfoHardware", class: clase = "", pagina = false, ...resto } = Astro.props;
---
<div class:list={["ventana", pagina && "ventana-pagina", clase]} data-ui={pagina ? undefined : ""} {...resto}>
  <div class="ventana-barra" aria-hidden="true" data-ui>
    <img src="img/favicon-32.png" alt="" width="16" height="16" loading="lazy" />
    <span>{titulo}</span>
    <i class="ventana-botones"><b></b><b></b><b></b></i>
  </div>
  <div class="ventana-cuerpo"><slot /></div>
</div>

<style>
  .ventana {
    position: relative; overflow: hidden; border-radius: var(--radio-ventana);
    background: var(--fondo); border: 1px solid var(--borde); /* taste-skill-ignore: ventana de Windows del programa (pieza data-ui) */
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.015) inset; /* taste-skill-ignore: ventana de Windows del programa (pieza data-ui) */
  }
  /* A escala de página: sin sombra; la separan del fondo el tono y el borde #17262A del programa */
  .ventana-pagina { box-shadow: none; }
  .ventana-barra { display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 12px; font-size: 13px; color: var(--texto-dim); background: #070B0D; }
  .ventana-barra img { width: 16px; height: 16px; }
  .ventana-botones { margin-left: auto; display: flex; gap: 22px; font-style: normal; }
  .ventana-botones b { position: relative; display: block; width: 11px; height: 11px; }
  .ventana-botones b:first-child::before { content: ""; position: absolute; left: 0; right: 0; top: 5px; height: 1px; background: #56646C; } /* taste-skill-ignore: botón minimizar de la barra de Windows */
  .ventana-botones b:nth-child(2) { border: 1px solid #56646C; border-radius: 1px; } /* taste-skill-ignore: botón maximizar de la barra de Windows */
  .ventana-botones b:last-child::before, .ventana-botones b:last-child::after {
    content: ""; position: absolute; left: -1px; right: -1px; top: 5px; height: 1px; background: #56646C; transform: rotate(45deg); /* taste-skill-ignore: botón cerrar de la barra de Windows */
  }
  .ventana-botones b:last-child::after { transform: rotate(-45deg); }
  .ventana-cuerpo { position: relative; }
</style>
